{
  "name": "proctor-app",
  "version": "1.0.0",
  "description": "Simple desktop proctoring test app",
  "main": "electron/main.js",
  "scripts": {
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "start": "electron .",
    "postinstall": "npm --prefix client install",
    "dist": "npm --prefix client run build && electron-builder --mac dmg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.proctor.app",
    "productName": "Proctored Test",
    "files": [
      "electron/**",
      "client/dist/**",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "The test takes photos of you to confirm who is taking it.",
        "NSScreenCaptureUsageDescription": "The test takes screenshots of your screen while you answer."
      }
    }
  }
}
